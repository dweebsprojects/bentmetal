{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bentmetal",
  "compatibility_date": "2026-07-16",
  "observability": {
    "enabled": true
  },
  // The Worker runs only for /quote-request, which copies contact form submissions to the
  // contract app. INTAKE_SECRET is a secret: `npx wrangler secret put INTAKE_SECRET`
  // (and in .dev.vars for local dev); it must match the contract app's INTAKE_SECRET.
  "main": "worker/index.mjs",
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "run_worker_first": ["/quote-request"]
  },
  "vars": {
    "CONTRACT_APP_URL": "https://quotes.bentmetal.ca"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
